APP_NAME="Nudge"
# For local development set APP_ENV=local and APP_DEBUG=true in your own .env. Never deploy with local or debug on.
APP_ENV=production
APP_KEY=
# After a key leak: old keys that only tracking and unsubscribe links still accept. See DEPLOYING.md.
# MARKETING_PREVIOUS_LINK_KEYS=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Behind a reverse proxy or load balancer: its IPs or CIDR ranges, comma-separated (or * if they change).
# TRUSTED_PROXIES=

# Who can sign up: invite (default, invited emails only), closed, or open.
REGISTRATION_MODE=invite
# Set to a long random value to create the first account in the browser, then remove it.
# SETUP_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job timeout (imports: 3600s).
# DB_QUEUE_RETRY_AFTER=3660
# REDIS_QUEUE_RETRY_AFTER=3660

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set a real mailer in production; "log" writes password-reset and invitation links to the log file.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
