{
    "name": "gerenuk/marketing-core",
    "description": "Core of the Gerenuk marketing platform: contacts, lists, segments, imports and the API.",
    "type": "library",
    "license": "FSL-1.1-Apache-2.0",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Gerenuk\\Marketing\\": "src/",
            "Gerenuk\\Marketing\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gerenuk\\Marketing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gerenuk\\Marketing\\MarketingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
